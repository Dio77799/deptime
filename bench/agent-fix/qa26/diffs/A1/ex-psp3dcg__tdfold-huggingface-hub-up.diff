 logger = logging.get_logger(__name__)  # pylint: disable=invalid-name
 
 
+def _download_community_pipeline(
+    url: str,
+    revision: str,
+    pipeline: str,
+    cache_dir: Optional[Union[str, os.PathLike]] = None,
+    force_download: bool = False,
+    local_files_only: bool = False,
+) -> str:
+    """
+    Downloads a community pipeline file from GitHub into a local cache and returns its path.
+
+    `huggingface_hub.cached_download` (which used to do this for arbitrary URLs) was removed from `huggingface_hub`,
+    and `hf_hub_download` only supports files hosted on the Hub.
+    """
+    cache_root = Path(cache_dir if cache_dir is not None else HF_HUB_CACHE) / "community_pipelines_github" / revision
+    cached_file = cache_root / f"{pipeline}.py"
+
+    if cached_file.is_file() and not force_download:
+        return str(cached_file)
+    if local_files_only:
+        raise EnvironmentError(
+            f"Cannot find {pipeline}.py in the local cache and outgoing traffic has been disabled "
+            "(`local_files_only=True`)."
+        )
+
+    # `urllib` errors (`URLError`, `HTTPError`) are subclasses of `OSError` (aka `EnvironmentError`).
+    content = request.urlopen(url).read()
+    cached_file.parent.mkdir(parents=True, exist_ok=True)
+    tmp_file = cached_file.with_name(cached_file.name + ".tmp")
+    tmp_file.write_bytes(content)
+    os.replace(tmp_file, cached_file)
+    return str(cached_file)
+
