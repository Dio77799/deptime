+def cut_dialogue_history(memory, keep_last_n_paragraphs=1):
+    """Trim the chat history in `memory` so that only the last human turn (and
+    the replies after it) is kept."""
+    messages = list(memory.chat_memory.messages)
+    human_idx = [i for i, m in enumerate(messages) if isinstance(m, HumanMessage)]
+    # Same condition as the old string-based version: it split on 'Human:', which
+    # yields one more paragraph than there are human turns.
+    if len(human_idx) + 1 <= keep_last_n_paragraphs:
+        return
+    memory.chat_memory.clear()
+    memory.chat_memory.add_messages(messages[human_idx[-1]:])
 
