+class LLamaIndexConversableAgent(ConversableAgent):
+    """An autogen agent backed by a llama-index workflow agent.
+
+    autogen's built-in LLamaIndexConversableAgent targets the legacy llama-index
+    AgentRunner API (agent.chat / agent.achat), which no longer exists, so a small
+    equivalent is provided here for the workflow based agents.
+    """
+
+    def __init__(self, name, llama_index_agent, memory, description, **kwargs):
+        if not description or not description.strip():
+            raise ValueError("description must be provided and non-empty")
+        super().__init__(name, description=description, **kwargs)
+        self._llama_index_agent = llama_index_agent
+        self._llama_index_memory = memory
+        # replace the default reply functions so replies are generated by the llama-index agent
+        self.replace_reply_func(ConversableAgent.generate_oai_reply, LLamaIndexConversableAgent._generate_oai_reply)
+        self.replace_reply_func(ConversableAgent.a_generate_oai_reply, LLamaIndexConversableAgent._a_generate_oai_reply)
+
+    def _extract_message_and_history(self, messages, sender):
+        """Split the conversation into the last message and the preceding history."""
+        if not messages:
+            messages = self._oai_messages[sender]
+        if not messages:
+            return "", []
+        message = messages[-1].get("content", "")
+        history_messages = []
+        for history_message in messages[:-1]:
+            content = history_message.get("content", "")
+            role = history_message.get("role", "user")
+            if role in ("user", "assistant"):
+                history_messages.append(ChatMessage(content=content, role=role))
+        return message, history_messages
+
+    def _generate_oai_reply(self, messages=None, sender=None, config=None):
+        return asyncio.run(self._a_generate_oai_reply(messages=messages, sender=sender, config=config))
+
+    async def _a_generate_oai_reply(self, messages=None, sender=None, config=None):
+        user_message, history = self._extract_message_and_history(messages=messages, sender=sender)
+        output = await self._llama_index_agent.run(
+            user_msg=user_message,
+            chat_history=history,
+            memory=self._llama_index_memory,
+            max_iterations=MAX_LOCATION_SPECIALIST_ITERATIONS,
+        )
+        return True, output.response.content or ""
+
 
