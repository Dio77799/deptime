diff --git a/utils/gradio_compat.py b/utils/gradio_compat.py
new file mode 100644
index 0000000..06b779d
--- /dev/null
+++ b/utils/gradio_compat.py
@@ -0,0 +1,114 @@
+"""Helpers bridging the gradio 3 style data this project was written for and what gradio 6 hands to / expects from
+event handlers.
+
+* ``gr.Chatbot`` only supports the "messages" format in gradio 6 (``[{"role": ..., "content": ...}]``), while the
+  chat logic in this project builds and mutates ``[[user, bot], ...]`` pairs. ``chatbot_pairs`` wraps an event handler
+  so the handler keeps working with pairs.
+* ``gr.File`` / ``gr.UploadButton`` hand over plain file paths instead of tempfile objects with a ``.name``.
+"""
+import functools
+import inspect
+
+
+def file_path(file):
+    """Returns the path of an uploaded file, whether gradio passes a path (gradio 4+) or a tempfile object."""
+    if isinstance(file, (str, bytes)) or hasattr(file, '__fspath__'):
+        return str(file)
+    if isinstance(file, dict):
+        return file.get('path') or file.get('name')
+    return file.name
+
+
+def _content_to_text(content):
+    if content is None:
+        return ''
+    if isinstance(content, str):
+        return content
+    if isinstance(content, dict):
+        if 'text' in content:
+            return str(content['text'])
+        return ''
+    if isinstance(content, (list, tuple)):
+        return ''.join(_content_to_text(c) for c in content)
+    return str(content)
+
+
+def messages_to_pairs(messages):
+    """Converts chatbot messages to ``[[user, bot], ...]`` pairs (lists, so they can be mutated in place)."""
+    if not isinstance(messages, (list, tuple)):
+        return messages
+    pairs = []
+    for message in messages:
+        if isinstance(message, (list, tuple)):  # already a pair
+            pairs.append([message[0], message[1]])
+            continue
+        role = message.get('role') if isinstance(message, dict) else getattr(message, 'role', None)
+        content = message.get('content') if isinstance(message, dict) else getattr(message, 'content', None)
+        text = _content_to_text(content)
+        if role == 'user':
+            pairs.append([text, ''])
+        elif pairs and pairs[-1][1] == '':
+            pairs[-1][1] = text
+        else:
+            pairs.append(['', text])
+    return pairs
+
+
+def pairs_to_messages(pairs):
+    """Converts ``[[user, bot], ...]`` pairs to chatbot messages. Values that are not lists (e.g. ``gr.update``)
+    are returned untouched."""
+    if not isinstance(pairs, (list, tuple)):
+        return pairs
+    messages = []
+    for pair in pairs:
+        if isinstance(pair, dict):  # already a message
+            messages.append(pair)
+            continue
+        user, bot = pair[0], pair[1]
+        if user is not None and user != '':
+            messages.append({'role': 'user', 'content': str(user)})
+        if bot is not None and bot != '':
+            messages.append({'role': 'assistant', 'content': str(bot)})
+    return messages
+
+
+def chatbot_pairs(fn, inputs=(), outputs=()):
+    """Wraps an event handler written for the tuple chatbot format.
+
+    Args:
+        fn: The handler (a function, bound method, or generator function).
+        inputs: Positions of the handler arguments that receive a chatbot value, converted to pairs.
+        outputs: Positions of the returned (or yielded) values that are chatbot values, converted to messages.
+            A handler returning a single value is treated as position 0.
+    """
+    inputs = tuple(inputs)
+    outputs = tuple(outputs)
+
+    def convert_in(args):
+        args = list(args)
+        for i in inputs:
+            if i < len(args):
+                args[i] = messages_to_pairs(args[i])
+        return args
+
+    def convert_out(result):
+        if not outputs:
+            return result
+        if not isinstance(result, tuple):
+            return pairs_to_messages(result) if 0 in outputs else result
+        result = list(result)
+        for i in outputs:
+            if i < len(result):
+                result[i] = pairs_to_messages(result[i])
+        return tuple(result)
+
+    if inspect.isgeneratorfunction(fn):
+        @functools.wraps(fn)
+        def wrapper(*args):
+            for result in fn(*convert_in(args)):
+                yield convert_out(result)
+    else:
