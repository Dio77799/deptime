+"""
+Minimal replacement for the `huggingface_hub.Repository` class, which was removed in `huggingface_hub` v1.0.
+
+Instead of driving the `git` CLI, this implementation talks to the Hub through the HTTP based `HfApi`. It only covers
+the subset of the old API used in this code base: creating/"cloning" a repo into a local folder, and pushing the
+content of that local folder to the Hub with `push_to_hub`.
+"""
+
+import os
+from concurrent.futures import Future
+from typing import Optional, Tuple, Union
+from urllib.parse import urlparse
+
+from huggingface_hub import HfApi, constants, create_repo, get_token
+
+
+class PushInProgress:
+    """
+    Tracks a push started with `Repository.push_to_hub(blocking=False)` (stand-in for the old `CommandInProgress`).
+    """
+
+    def __init__(self, future: Future):
+        self._future = future
+
+    @property
+    def is_done(self) -> bool:
+        return self._future.done()
+
+    @property
+    def failed(self) -> bool:
+        return self._future.done() and self._future.exception() is not None
+
+    @property
+    def status(self) -> int:
+        """0 if the push succeeded, -1 if it failed, `None` if it is still running."""
+        if not self._future.done():
+            return None
+        return -1 if self._future.exception() is not None else 0
+
+    def result(self):
+        return self._future.result()
+
+
+def _repo_id_from_clone_from(clone_from: str) -> str:
+    """Accepts either a `namespace/name` repo id or a full `https://huggingface.co/namespace/name` url."""
+    clone_from = str(clone_from)
+    if clone_from.startswith(("http://", "https://")):
+        clone_from = urlparse(clone_from).path
+    repo_id = clone_from.strip("/")
+    if repo_id.endswith(".git"):
+        repo_id = repo_id[: -len(".git")]
+    return repo_id
+
+
+def _read_gitignore_patterns(local_dir: str):
+    path = os.path.join(local_dir, ".gitignore")
+    if not os.path.isfile(path):
+        return []
+    with open(path, "r", encoding="utf-8") as f:
+        return [line.strip() for line in f if line.strip() and not line.strip().startswith("#")]
+
+
+class Repository:
+    """
+    Helper to upload the content of a local folder to a repo on the Hub.
+
+    Args:
+        local_dir (`str`):
+            Local folder whose content is pushed to the Hub.
+        clone_from (`str`, *optional*):
+            Repo id (`namespace/name`) or url of the Hub repo to push to. The repo is created if it does not exist yet.
+            Unlike the old git-based class, existing remote files are *not* downloaded in `local_dir`.
+        use_auth_token (`str` or `bool`, *optional*):
+            Token to use. If `True` (or `None`), the token saved by `huggingface-cli login` is used.
+        token (`str` or `bool`, *optional*):
+            Alias of `use_auth_token`.
+    """
+
+    def __init__(
+        self,
+        local_dir: Union[str, os.PathLike],
+        clone_from: Optional[str] = None,
+        use_auth_token: Optional[Union[bool, str]] = None,
+        token: Optional[Union[bool, str]] = None,
+        **kwargs
+    ):
+        self.local_dir = os.path.abspath(str(local_dir))
+        self.token = token if token is not None else use_auth_token
+        if isinstance(self.token, bool):
+            # `True` means "use the saved token", `False` means no token.
+            self.token = get_token() if self.token else None
+        self.api = HfApi(token=self.token)
+        os.makedirs(self.local_dir, exist_ok=True)
+
+        self.repo_id = None
+        if clone_from is not None:
+            self.repo_id = _repo_id_from_clone_from(clone_from)
+            create_repo(self.repo_id, token=self.token, exist_ok=True)
+
+    @property
+    def remote_url(self) -> str:
+        return f"{constants.ENDPOINT}/{self.repo_id}"
+
+    def git_pull(self, rebase: bool = False, **kwargs):
+        """No-op, kept for backward compatibility: there is no local git clone to update anymore."""
+
+    def push_to_hub(
+        self,
+        commit_message: str = "commit files to HF hub",
+        blocking: bool = True,
+        clean_ok: bool = True,
+        auto_lfs_prune: bool = False,
+    ) -> Union[str, Tuple[str, Optional[PushInProgress]]]:
+        """
+        Uploads the content of `local_dir` to the Hub in a single commit.
+
+        Patterns listed in a `.gitignore` file at the root of `local_dir` are skipped.
+
+        Returns:
+            The url of the commit if `blocking=True`, otherwise a tuple with the url of the repo and a
+            [`PushInProgress`] to track the upload.
+        """
+        if self.repo_id is None:
+            raise ValueError("This repository has no `clone_from` target, so there is nothing to push to.")
+
+        ignore_patterns = [".git", ".git/*"] + _read_gitignore_patterns(self.local_dir)
+        kwargs = dict(
+            repo_id=self.repo_id,
+            folder_path=self.local_dir,
+            commit_message=commit_message,
+            ignore_patterns=ignore_patterns,
+            token=self.token,
+        )
+        if blocking:
+            commit_info = self.api.upload_folder(**kwargs)
+            # `upload_folder` returns a `CommitInfo` in recent versions (and a url string in older ones).
+            return getattr(commit_info, "commit_url", None) or str(commit_info)
+
+        future = self.api.upload_folder(run_as_future=True, **kwargs)
+        return self.remote_url, PushInProgress(future)
