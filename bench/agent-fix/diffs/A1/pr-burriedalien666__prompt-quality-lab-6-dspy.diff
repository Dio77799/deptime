--- a/src/prompt_ops/core/evaluation.py
+++ b/src/prompt_ops/core/evaluation.py
@@ -98,7 +98,19 @@ class Evaluator:
             If return_outputs is False, returns the average score.
             If return_outputs is True, returns (score, outputs).
         """
-        return self._dspy_evaluator(program, return_outputs=return_outputs)
+        # In DSPy 3.x, Evaluate returns an EvaluationResult (with .score and
+        # .results) and no longer accepts return_outputs.
+        result = self._dspy_evaluator(program)
+        score = self._extract_score(result)
+        if return_outputs:
+            return score, getattr(result, "results", None)
+        return score
+
+    @staticmethod
+    def _extract_score(result) -> float:
+        """Extract a float score from a DSPy EvaluationResult (or a raw number)."""
+        score = getattr(result, "score", result)
+        return float(score)
 
 
 class StatisticalEvaluator(Evaluator):
