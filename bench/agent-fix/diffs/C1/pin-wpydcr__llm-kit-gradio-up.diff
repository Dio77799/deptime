diff --git a/utils/gradio_compat.py b/utils/gradio_compat.py
new file mode 100644
index 0000000..8c1388d
--- /dev/null
+++ b/utils/gradio_compat.py
@@ -0,0 +1,89 @@
+"""Compatibility helpers for Gradio 6.
+
+Gradio 6 removed the legacy "tuples" chat format: ``gr.Chatbot`` only accepts and
+returns a list of ``{"role": ..., "content": ...}`` messages. The handlers in this
+project work with ``[[user, bot], ...]`` pairs, so ``patch_chatbot`` makes
+``gr.Chatbot`` convert between the two formats at the component boundary.
+"""
+import gradio as gr
+
+
+def file_path(f):
+    """Path of an uploaded file.
+
+    ``gr.File`` used to hand handlers a tempfile wrapper with a ``.name`` attribute;
+    Gradio >= 4 passes the filepath as a plain ``str``.
+    """
+    return getattr(f, "name", f)
+
+
+def _text(content):
+    """Reduce message content (str / dict / list of parts) to what the handlers expect."""
+    if isinstance(content, list):
+        parts = [_text(c) for c in content]
+        parts = [p for p in parts if p]
+        return "\n".join(parts) if parts else ""
+    if isinstance(content, dict):
+        if "text" in content:
+            return content["text"]
+        if "path" in content:
+            return content["path"]
+        return str(content)
+    return content
+
+
+def messages_to_pairs(messages):
+    """[{"role", "content"}, ...] -> [[user, bot], ...]"""
+    pairs = []
+    for msg in messages or []:
+        if isinstance(msg, dict):
+            role, content = msg.get("role"), _text(msg.get("content"))
+        else:  # already a pair
+            pairs.append(list(msg))
+            continue
+        if role == "user":
+            pairs.append([content, None])
+        else:
+            if pairs and pairs[-1][1] is None and pairs[-1][0] is not None:
+                pairs[-1][1] = content
+            else:
+                pairs.append([None, content])
+    return pairs
+
+
+def pairs_to_messages(pairs):
+    """[[user, bot], ...] -> [{"role", "content"}, ...]"""
+    messages = []
+    for pair in pairs or []:
+        if isinstance(pair, dict):  # already a message
+            messages.append(pair)
+            continue
+        user, bot = pair[0], pair[1]
+        if user is not None:
+            messages.append({"role": "user", "content": user})
+        if bot is not None:
+            messages.append({"role": "assistant", "content": bot})
+    return messages
+
+
+def patch_chatbot():
+    """Make gr.Chatbot accept/return the legacy ``[[user, bot], ...]`` format."""
+    if getattr(gr.Chatbot, "_tuples_patched", False):
+        return
+    preprocess_ori = gr.Chatbot.preprocess
+    postprocess_ori = gr.Chatbot.postprocess
+
+    def preprocess(self, payload):
+        return messages_to_pairs(preprocess_ori(self, payload))
+
+    def postprocess(self, value):
+        if value is None:
+            return postprocess_ori(self, value)
+        return postprocess_ori(self, pairs_to_messages(value))
+
+    gr.Chatbot.preprocess = preprocess
+    gr.Chatbot.postprocess = postprocess
+    gr.Chatbot._tuples_patched = True
+
+
+patch_chatbot()
