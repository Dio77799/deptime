             If return_outputs is False, returns the average score.
             If return_outputs is True, returns (score, outputs).
         """
-        return self._dspy_evaluator(program, return_outputs=return_outputs)
+        # DSPy >= 3.0 no longer accepts `return_outputs`; it always returns an
+        # EvaluationResult with `.score` and `.results` (example, prediction, score).
+        result = self._dspy_evaluator(program)
+        score = self._extract_score(result)
+        if return_outputs:
+            return score, getattr(result, "results", [])
+        return score
+
+    @staticmethod
+    def _extract_score(result) -> float:
+        """Extract a numeric score from a DSPy evaluation result."""
+        if hasattr(result, "score"):
+            return result.score
+        if isinstance(result, tuple):
+            return result[0]
+        return result
 
 
