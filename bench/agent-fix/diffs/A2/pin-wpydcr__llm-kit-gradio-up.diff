diff --git a/utils/gradio_compat.py b/utils/gradio_compat.py
new file mode 100644
index 0000000..36b188c
--- /dev/null
+++ b/utils/gradio_compat.py
@@ -0,0 +1,142 @@
+"""Helpers that bridge the data formats used by this project and gradio >= 6.
+
+* ``gr.Chatbot`` only understands the "messages" format in gradio 6
+  (``[{"role": "user", "content": ...}, {"role": "assistant", "content": ...}]``).
+  The chat back-ends in this project work with ``[user, bot]`` pairs, so the
+  ``chatbot_adapter`` decorator converts at the boundary between gradio and the
+  handler.
+* ``gr.File`` / ``gr.UploadButton`` hand the handler plain file path strings
+  (or a list of them) instead of tempfile wrappers that expose ``.name``.
+"""
+import functools
+import inspect
+
+
+def file_path(file):
+    """Return the path of an uploaded file (str path, tempfile wrapper or dict)."""
+    if file is None:
+        return None
+    if isinstance(file, str):
+        return file
+    if isinstance(file, dict):
+        return file.get('path') or file.get('name')
+    return getattr(file, 'path', None) or file.name
+
+
+def file_paths(files):
+    """Return a list of paths from a single upload or a list of uploads."""
+    if files is None:
+        return []
+    if not isinstance(files, (list, tuple)):
+        files = [files]
+    return [file_path(f) for f in files]
+
+
+def _content_to_text(content):
+    """Flatten the content of a gradio chatbot message to a string."""
+    if content is None:
+        return ''
+    if isinstance(content, str):
+        return content
+    if isinstance(content, dict):
+        if 'text' in content:
+            return content['text'] or ''
+        if 'file' in content:
+            return _content_to_text(content['file'])
+        return str(content.get('path') or content.get('value') or '')
+    if isinstance(content, (list, tuple)):
+        return ''.join(_content_to_text(c) for c in content)
+    return str(content)
+
+
+def to_pairs(chatbot):
+    """Convert a gradio 6 chatbot value (messages) to a list of ``[user, bot]`` pairs.
+
+    Values that already are pairs are accepted and returned as a new list.
+    """
+    pairs = []
+    if not chatbot:
+        return pairs
+    for message in chatbot:
+        if isinstance(message, dict):
+            role = message.get('role')
+            text = _content_to_text(message.get('content'))
+            if role == 'user':
+                pairs.append([text, ''])
+            elif pairs and pairs[-1][1] in ('', None) and pairs[-1][0] is not None:
+                pairs[-1][1] = text
+            else:
+                pairs.append([None, text])
+        else:
+            pairs.append(list(message))
+    return pairs
+
+
+def to_messages(chatbot):
+    """Convert a list of ``[user, bot]`` pairs to gradio 6 chatbot messages.
+
+    Anything that is not a list (``None``, ``gr.update(...)``) is returned unchanged.
+    """
+    if not isinstance(chatbot, (list, tuple)):
+        return chatbot
+    messages = []
+    for item in chatbot:
+        if isinstance(item, dict):
+            messages.append(item)
+            continue
+        user, bot = item[0], item[1]
+        if user is not None and user != '':
+            messages.append({'role': 'user', 'content': str(user)})
+        if bot is not None and bot != '':
+            messages.append({'role': 'assistant', 'content': str(bot)})
+    return messages
+
+
+def chatbot_adapter(inputs=(), outputs=()):
+    """Decorator for event handlers working on ``[user, bot]`` chat pairs.
+
+    Args:
+        inputs: names of the parameters that receive a chatbot value; they are
+            converted from messages to pairs before the handler runs.
+        outputs: indexes of the returned values (or yielded tuple values) that
+            are chatbot values; they are converted from pairs to messages.
+            For a handler returning a single value use ``0``.
+    """
+    inputs = tuple(inputs)
+    outputs = tuple(outputs)
+
+    def convert_outputs(result):
+        if isinstance(result, tuple):
+            result = list(result)
+            for index in outputs:
+                if index < len(result):
+                    result[index] = to_messages(result[index])
+            return tuple(result)
+        if 0 in outputs:
+            return to_messages(result)
+        return result
+
+    def decorator(fn):
+        signature = inspect.signature(fn)
+
+        def convert_inputs(args, kwargs):
+            bound = signature.bind(*args, **kwargs)
+            for name in inputs:
+                if name in bound.arguments:
+                    bound.arguments[name] = to_pairs(bound.arguments[name])
+            return bound.args, bound.kwargs
+
+        if inspect.isgeneratorfunction(fn):
+            @functools.wraps(fn)
+            def wrapper(*args, **kwargs):
+                args, kwargs = convert_inputs(args, kwargs)
+                for result in fn(*args, **kwargs):
+                    yield convert_outputs(result)
+        else:
+            @functools.wraps(fn)
+            def wrapper(*args, **kwargs):
+                args, kwargs = convert_inputs(args, kwargs)
+                return convert_outputs(fn(*args, **kwargs))
+        return wrapper
+
+    return decorator
