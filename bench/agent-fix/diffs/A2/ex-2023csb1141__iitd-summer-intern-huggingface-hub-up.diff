+def _repo_id_from_url_or_name(repo_url_or_id: str) -> str:
+    """Extracts the `namespace/name` repo id from a hub URL (or returns the id unchanged)."""
+    repo_url_or_id = str(repo_url_or_id)
+    if repo_url_or_id.startswith(("http://", "https://")):
+        path = urlparse(repo_url_or_id).path.strip("/")
+        if path.endswith(".git"):
+            path = path[: -len(".git")]
+        return path
+    return repo_url_or_id
+
+
+class Repository:
+    """
+    Minimal replacement for `huggingface_hub.Repository` (removed in huggingface-hub v1+), built on the HTTP-based
+    `HfApi` instead of a local git clone. Files that are in `local_dir` are uploaded with `HfApi.upload_folder`, and
+    `git_pull` downloads the current content of the repo into `local_dir`.
+    """
+
+    def __init__(
+        self,
+        local_dir: Union[str, os.PathLike],
+        clone_from: Optional[str] = None,
+        use_auth_token: Optional[Union[bool, str]] = None,
+        token: Optional[Union[bool, str]] = None,
+    ):
+        self.local_dir = str(local_dir)
+        if token is None:
+            token = use_auth_token
+        if isinstance(token, str):
+            self.token = token
+        elif token:
+            self.token = get_token()
+        else:
+            self.token = None
+        self.api = HfApi(token=self.token)
+        os.makedirs(self.local_dir, exist_ok=True)
+
+        if clone_from is None:
+            raise ValueError("`clone_from` (a repo id or url) is required to create a `Repository`.")
+        self.repo_id = _repo_id_from_url_or_name(clone_from)
+        try:
+            self.api.create_repo(self.repo_id, exist_ok=True)
+        except HfHubHTTPError as e:
+            raise EnvironmentError(f"Could not access or create the repository {self.repo_id}: {e}") from e
+
+    def git_pull(self, rebase: bool = False):
+        """Downloads the files of the remote repo that are not yet in `local_dir` (existing local files are kept)."""
+        try:
+            snapshot_download(self.repo_id, local_dir=self.local_dir, token=self.token)
+        except HfHubHTTPError as e:
+            # An empty/new repo has nothing to pull.
+            logger.warning(f"Could not pull {self.repo_id}: {e}")
+
+    def _ignore_patterns(self) -> List[str]:
+        patterns = [".git", ".git/*"]
+        gitignore = os.path.join(self.local_dir, ".gitignore")
+        if os.path.isfile(gitignore):
+            with open(gitignore, encoding="utf-8") as f:
+                for line in f.read().splitlines():
+                    line = line.strip()
+                    if line and not line.startswith("#"):
+                        patterns.append(line)
+        return patterns
+
+    def push_to_hub(
+        self, commit_message: str = "commit files to the hub", blocking: bool = True, auto_lfs_prune: bool = False
+    ):
+        """
+        Uploads `local_dir` to the repo. Returns the commit url if `blocking=True`, otherwise a tuple
+        `(None, future)` where `future` is a `concurrent.futures.Future` (use `future.done()` to track progress).
+        `auto_lfs_prune` is accepted for backward compatibility and ignored.
+        """
+        if blocking:
+            commit_info = self.api.upload_folder(
+                repo_id=self.repo_id,
+                folder_path=self.local_dir,
+                commit_message=commit_message,
+                ignore_patterns=self._ignore_patterns(),
+            )
+            return commit_info.commit_url
+        future = self.api.upload_folder(
+            repo_id=self.repo_id,
+            folder_path=self.local_dir,
+            commit_message=commit_message,
+            ignore_patterns=self._ignore_patterns(),
+            run_as_future=True,
+        )
+        return None, future
+
