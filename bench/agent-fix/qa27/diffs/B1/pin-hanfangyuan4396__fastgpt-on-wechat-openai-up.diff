diff --git a/bot/openai/openai_client.py b/bot/openai/openai_client.py
new file mode 100644
index 0000000..ac20ce6
--- /dev/null
+++ b/bot/openai/openai_client.py
@@ -0,0 +1,47 @@
+# encoding:utf-8
+"""Builds openai>=1.0 client objects from the project config.
+
+openai 0.x used module-level settings (openai.api_key, openai.api_base, openai.proxy,
+openai.api_type, ...). From 1.0 on, requests go through client objects instead.
+"""
+
+import httpx
+import openai
+
+from config import conf
+
+DEFAULT_BASE_URL = "https://api.openai.com/v1"
+
+
+def _http_client():
+    proxy = conf().get("proxy")
+    if proxy:
+        return httpx.Client(proxy=proxy)
+    return None
+
+
+def create_openai_client(api_key=None, base_url=None):
+    """OpenAI client from the "open_ai_*" and "proxy" config values."""
+    return openai.OpenAI(
+        # an empty key would make the client raise on construction; the request fails later instead
+        api_key=api_key or conf().get("open_ai_api_key") or "missing-api-key",
+        base_url=base_url or conf().get("open_ai_api_base") or DEFAULT_BASE_URL,
+        http_client=_http_client(),
+    )
+
+
+def create_azure_client(api_key=None, azure_endpoint=None, api_version=None):
+    """Azure OpenAI client; the "model" of each request is the Azure deployment name."""
+    return openai.AzureOpenAI(
+        api_key=api_key or conf().get("open_ai_api_key") or "missing-api-key",
+        azure_endpoint=azure_endpoint or conf().get("open_ai_api_base"),
+        api_version=api_version or conf().get("azure_api_version", "2023-06-01-preview"),
+        http_client=_http_client(),
+    )
+
+
+def with_api_key(client, api_key=None):
+    """The client, or a copy of it that uses `api_key` for its requests."""
+    if api_key:
+        return client.with_options(api_key=api_key)
+    return client
