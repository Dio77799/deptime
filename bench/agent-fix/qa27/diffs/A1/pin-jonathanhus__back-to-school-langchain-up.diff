+# Example chain with few-shot examples (LLMChain was removed in langchain 1.x; use a runnable chain instead)
+llm_fewshot_chain = few_shot_prompt_template | llm | StrOutputParser()
+
+
+class FewShotChain:
+    """Wraps the runnable chain so that `invoke` returns a dict of the inputs plus the LLM output under 'text' (as LLMChain did)."""
+    def __init__(self, runnable, verbose: bool = False) -> None:
+        self.runnable = runnable
+        self.config = {"callbacks": [ConsoleCallbackHandler()]} if verbose else {}
+
+    def invoke(self, inputs: dict[str, Any]) -> dict[str, Any]:
+        text = self.runnable.invoke(inputs, config=self.config)
+        return {**inputs, 'text': text}
+
+
+chain = FewShotChain(llm_fewshot_chain, verbose=args.verbose)
 
