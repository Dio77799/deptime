+def load_causal_lm_8bit(model_path):
+    '''
+    Load a causal LM quantized to 8 bit.
+    transformers>=5 removed the `load_in_8bit` kwarg of `from_pretrained`; a BitsAndBytesConfig is required.
+    '''
+    return transformers.AutoModelForCausalLM.from_pretrained(
+        model_path,
+        quantization_config=transformers.BitsAndBytesConfig(load_in_8bit=True),
+        device_map="auto"
+    )
+
+
+class DataCollatorForCompletionOnlyLM:
+    '''
+    Pads a batch and masks (label -100) everything up to and including the first occurrence of
+    `response_template`, so the loss is only computed on the response.
+    (trl removed its own DataCollatorForCompletionOnlyLM in the versions that support transformers 5.)
+    '''
+    def __init__(self, response_template, tokenizer, ignore_index=-100):
+        self.tokenizer = tokenizer
+        self.ignore_index = ignore_index
+        self.response_token_ids = tokenizer.encode(response_template, add_special_tokens=False)
+
+    def __call__(self, examples):
+        features = [{"input_ids": list(e["input_ids"])} for e in examples]
+        batch = self.tokenizer.pad(features, padding=True, return_tensors="pt")
+        labels = batch["input_ids"].clone()
+        template = self.response_token_ids
+
+        for i in range(labels.shape[0]):
+            ids = batch["input_ids"][i].tolist()
+            start = None
+            for idx in range(len(ids) - len(template) + 1):
+                if ids[idx:idx + len(template)] == template:
+                    start = idx + len(template)
+                    break
+
+            if start is None:
+                print("Warning: response template not found in a sample; ignoring it for the loss.")
+                labels[i, :] = self.ignore_index
+            else:
+                labels[i, :start] = self.ignore_index
+
+        labels[batch["attention_mask"] == 0] = self.ignore_index
+        batch["labels"] = labels
+        return batch
+
+
 
 
 
