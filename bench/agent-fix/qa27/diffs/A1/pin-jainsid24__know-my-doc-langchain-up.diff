+@tool
+def state_of_union_qa(question: str) -> str:
+    """Useful for when you need to answer questions about the most recent state of the union address.
+    Input should be a fully formed question. Returns the most relevant passages from the address."""
+    return "\n\n".join(d.page_content for d in docsearch.similarity_search(question))
+
+
+_OPERATORS = {
+    ast.Add: operator.add,
+    ast.Sub: operator.sub,
+    ast.Mult: operator.mul,
+    ast.Div: operator.truediv,
+    ast.Pow: operator.pow,
+    ast.Mod: operator.mod,
+    ast.USub: operator.neg,
+}
+
+
+def _eval_node(node):
+    if isinstance(node, ast.Constant) and isinstance(node.value, (int, float)):
+        return node.value
+    if isinstance(node, ast.BinOp) and type(node.op) in _OPERATORS:
+        return _OPERATORS[type(node.op)](_eval_node(node.left), _eval_node(node.right))
+    if isinstance(node, ast.UnaryOp) and type(node.op) in _OPERATORS:
+        return _OPERATORS[type(node.op)](_eval_node(node.operand))
+    raise ValueError("Unsupported expression")
+
+
+@tool
+def calculator(expression: str) -> str:
+    """Useful for when you need to answer questions about math.
+    Input should be a single arithmetic expression, e.g. '37593 * 67' or '2 ** 0.5'."""
+    return str(_eval_node(ast.parse(expression.strip(), mode="eval").body))
+
+
+tools = [state_of_union_qa, calculator]
+
+agent = create_agent(llm, tools)
 
 
