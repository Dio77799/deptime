diff --git a/bot/openai/open_ai_client.py b/bot/openai/open_ai_client.py
new file mode 100644
index 0000000..ecf5117
--- /dev/null
+++ b/bot/openai/open_ai_client.py
@@ -0,0 +1,33 @@
+import openai
+
+from config import conf
+
+
+def _http_client():
+    """Build an HTTP client honoring the `proxy` config (openai>=1 no longer supports `openai.proxy`)."""
+    proxy = conf().get("proxy")
+    if proxy:
+        return openai.DefaultHttpx2Client(proxy=proxy)
+    return None
+
+
+def build_openai_client(api_key=None):
+    """Create an OpenAI client from the project config."""
+    kwargs = {
+        "api_key": api_key or conf().get("open_ai_api_key") or "",
+        "http_client": _http_client(),
+    }
+    api_base = conf().get("open_ai_api_base")
+    if api_base:
+        kwargs["base_url"] = api_base
+    return openai.OpenAI(**kwargs)
+
+
+def build_azure_client(api_key=None):
+    """Create an AzureOpenAI client from the project config (`open_ai_api_base` is the Azure endpoint)."""
+    return openai.AzureOpenAI(
+        api_key=api_key or conf().get("open_ai_api_key") or "",
+        azure_endpoint=conf().get("open_ai_api_base"),
+        api_version=conf().get("azure_api_version", "2023-06-01-preview"),
+        http_client=_http_client(),
+    )
