diff --git a/dev_opsgpt/chat/utils.py b/dev_opsgpt/chat/utils.py
index f8afb10..7237f21 100644
--- a/dev_opsgpt/chat/utils.py
+++ b/dev_opsgpt/chat/utils.py
@@ -1,6 +1,51 @@
 import asyncio
-from typing import Awaitable
+from typing import Any, AsyncIterator, Awaitable
 from pydantic import BaseModel, Field
+from langchain_core.callbacks import AsyncCallbackHandler
+
+
+class AsyncIteratorCallbackHandler(AsyncCallbackHandler):
+    """Yield streamed LLM tokens through an async iterator.
+
+    `langchain.callbacks.AsyncIteratorCallbackHandler` no longer exists in langchain 1.x,
+    so a minimal equivalent is kept here, built on langchain-core.
+    """
+
+    def __init__(self) -> None:
+        self.queue: asyncio.Queue = asyncio.Queue()
+        self.done = asyncio.Event()
+
+    async def on_llm_start(self, serialized: Any, prompts: Any, **kwargs: Any) -> None:
+        self.done.clear()
+
+    async def on_chat_model_start(self, serialized: Any, messages: Any, **kwargs: Any) -> None:
+        self.done.clear()
+
+    async def on_llm_new_token(self, token: str, **kwargs: Any) -> None:
+        if token is not None and token != "":
+            self.queue.put_nowait(token)
+
+    async def on_llm_end(self, response: Any, **kwargs: Any) -> None:
+        self.done.set()
+
+    async def on_llm_error(self, error: BaseException, **kwargs: Any) -> None:
+        self.done.set()
+
+    async def aiter(self) -> AsyncIterator[str]:
+        while not self.queue.empty() or not self.done.is_set():
+            done, other = await asyncio.wait(
+                [
+                    asyncio.ensure_future(self.queue.get()),
+                    asyncio.ensure_future(self.done.wait()),
+                ],
+                return_when=asyncio.FIRST_COMPLETED,
+            )
+            if other:
+                other.pop().cancel()
+            token_or_done = done.pop().result()
+            if token_or_done is True:
+                break
+            yield token_or_done
 
 
 async def wrap_done(fn: Awaitable, event: asyncio.Event):
